{
  "name": "dsh-cost-router",
  "version": "0.5.0",
  "description": "DSH plugin: 复杂任务分解 + 多模型分派。用 DSH 已配置的模型渠道（含免费渠道）按能力匹配子任务，汇总成稿并逐笔记账。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs"
  },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "config/",
    "skills/",
    "scripts/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "routing",
    "orchestration",
    "multi-model",
    "token-saving"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.7-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1 || ^0.1.7-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1 || ^0.1.7-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": false },
    "@deepseek-ai/dsh-llm": { "optional": false },
    "@deepseek-ai/dsh-skill": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": false },
    "@deepseek-ai/schemastery": { "optional": false }
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18.0.0" },
  "repository": { "type": "git", "url": "git+https://github.com/jy02815803/dsh-cost-router.git" },
  "homepage": "https://github.com/jy02815803/dsh-cost-router#readme",
  "bugs": { "url": "https://github.com/jy02815803/dsh-cost-router/issues" }
}
